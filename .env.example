# ==========================================
# CareFlow Backend Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/careflow
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT Authentication Secret Key (Minimum 256 bits for HS256)
JWT_SECRET=CareFlowSecureJwtSecretKeyMustBeAtLeast256BitsLongForHS256AlgorithmCareFlow2026

# Google Gemini API Key for AI features (Get from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
